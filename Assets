export function esc(v){return String(v??'').replace(/[&<>'\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[c]))}
export function money(v,currency='FCFA'){return Number(v||0).toLocaleString('fr-FR')+' '+currency}
export function distanceMeters(a,b){if(!a||!b)return Infinity;const R=6371000,toRad=x=>x*Math.PI/180,dLat=toRad(b.lat-a.lat),dLon=toRad(b.lng-a.lng),x=Math.sin(dLat/2)**2+Math.cos(toRad(a.lat))*Math.cos(toRad(b.lat))*Math.sin(dLon/2)**2;return 2*R*Math.asin(Math.sqrt(x))}
export function createOfflineQueue(key='nzila_offline_queue'){const read=()=>{try{return JSON.parse(localStorage.getItem(key)||'[]')}catch{return[]}};const write=x=>localStorage.setItem(key,JSON.stringify(x));return {push(action){const q=read();q.push({...action,id:crypto.randomUUID?.()||String(Date.now()+Math.random())});write(q)},read,remove(id){write(read().filter(x=>x.id!==id))},clear:()=>write([])}}
export function installBusyButtons(selector='button[data-nzila-busy]'){document.addEventListener('click',e=>{const b=e.target.closest(selector);if(!b||b.disabled)return;b.disabled=true;const label=b.innerHTML;b.dataset.nzilaLabel=label;b.innerHTML='<span style="opacity:.75">⏳</span> '+(b.dataset.busyText||'Traitement…');setTimeout(()=>{b.disabled=false;b.innerHTML=b.dataset.nzilaLabel||label},2500)})}
export async function osrmRoute(from,to){const u=`https://router.project-osrm.org/route/v1/driving/${from.lng},${from.lat};${to.lng},${to.lat}?overview=false&steps=false`;const r=await fetch(u);if(!r.ok)throw new Error('ROUTING_HTTP_'+r.status);const j=await r.json();if(j.code!=='Ok'||!j.routes?.[0])throw new Error('ROUTE_NOT_FOUND');return {distance_km:j.routes[0].distance/1000,duration_min:j.routes[0].duration/60}}
export async function geocodeCongo(query){const u='https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=cg&q='+encodeURIComponent(query);const r=await fetch(u,{headers:{Accept:'application/json'}});if(!r.ok)throw new Error('GEOCODE_HTTP_'+r.status);const j=await r.json();if(!j[0])throw new Error('DESTINATION_NOT_FOUND');return {lat:Number(j[0].lat),lng:Number(j[0].lon),display_name:j[0].display_name}}
