<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NZILA Driver — Cockpit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{
 --night:#07111f;--night2:#0b1b2f;--blue:#123c68;--blue2:#1c5b91;
 --gold:#d8a84e;--gold2:#f0cc78;--copper:#bd7045;--cream:#f7f3ec;
 --white:#fff;--ink:#17202b;--muted:#707985;--line:#e5dfd6;
 --ok:#25845e;--danger:#b94b4b;--shadow:0 14px 38px rgba(7,17,31,.11)
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#e7e2da;color:var(--ink);font-family:Manrope,sans-serif}
button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}.hidden{display:none!important}
.app{max-width:560px;min-height:100vh;margin:auto;background:var(--cream);padding-bottom:84px;box-shadow:0 0 60px #0002}
.top{height:70px;background:#fffffff2;backdrop-filter:blur(18px);border-bottom:1px solid #0000000b;padding:0 16px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:1000}
.brand{display:flex;align-items:center;gap:9px}.logo{width:41px;height:41px;border-radius:14px;background:linear-gradient(145deg,var(--gold),var(--copper));color:#fff;display:grid;place-items:center;font:800 20px Outfit;box-shadow:0 8px 22px #bd70452e}.brand b{font:800 18px Outfit}.brand small{display:block;color:var(--muted);font-size:8px;letter-spacing:1.4px;text-transform:uppercase}
.iconbtn{width:40px;height:40px;border-radius:13px;background:#fff;border:1px solid var(--line)}
.page{display:none}.page.active{display:block;animation:appear .25s ease}@keyframes appear{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
.hero{padding:24px 17px 27px;background:radial-gradient(circle at 90% 0,#d8a84e55,transparent 32%),radial-gradient(circle at 0 100%,#1c5b9140,transparent 35%),linear-gradient(145deg,var(--night),var(--night2));color:#fff;border-radius:0 0 30px 30px;position:relative;overflow:hidden}
.hero:after{content:"";position:absolute;inset:-50%;background:repeating-linear-gradient(45deg,transparent 0,transparent 31px,#d8a84e09 32px,#d8a84e09 33px);transform:rotate(9deg)}
.hero>*{position:relative;z-index:1}.eyebrow{color:var(--gold2);font-size:10px;font-weight:800;letter-spacing:1.2px}.hero h1{font:800 30px/1.04 Outfit;margin:8px 0}.hero p{font-size:11px;line-height:1.6;color:#ffffffb8;margin:0}
.wrap{padding:0 13px;margin-top:-12px;position:relative;z-index:5}.card{background:#fff;border:1px solid var(--line);border-radius:21px;padding:17px;box-shadow:var(--shadow);margin-bottom:11px}
.statusbar{display:flex;align-items:center;justify-content:space-between;gap:10px}.status-dot{width:11px;height:11px;border-radius:50%;background:#a9b0b6;box-shadow:0 0 0 5px #a9b0b61a}.online .status-dot{background:#2ba56e;box-shadow:0 0 0 5px #2ba56e1f;animation:pulse 1.8s infinite}@keyframes pulse{50%{box-shadow:0 0 0 10px transparent}}
.status-title{font:800 15px Outfit}.muted{color:var(--muted);font-size:10px;line-height:1.55}.switch{width:58px;height:33px;border-radius:99px;background:#d8d4cc;padding:4px}.switch i{display:block;width:25px;height:25px;background:#fff;border-radius:50%;transition:.2s}.switch.on{background:var(--gold)}.switch.on i{transform:translateX(25px)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.metric{background:#f5f1ea;border-radius:17px;padding:14px}.metric b{display:block;font:800 23px Outfit}.metric span{font-size:9px;color:var(--muted)}
.sectionhead{display:flex;justify-content:space-between;align-items:end;margin:18px 2px 9px}.sectionhead h2{font:700 21px Outfit;margin:0}.sectionhead span{font-size:9px;color:var(--muted)}
.progress{height:8px;border-radius:99px;background:#ebe5dc;overflow:hidden;margin-top:9px}.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--gold),var(--copper));border-radius:inherit}
.primary,.dark,.outline{width:100%;min-height:47px;border-radius:15px;font-weight:800}.primary{background:linear-gradient(135deg,var(--gold),var(--copper));color:#fff;box-shadow:0 10px 23px #bd70452e}.dark{background:var(--night);color:#fff}.outline{background:#fff;color:var(--night);border:1px solid var(--line)}
.smallbtn{min-height:39px!important;width:auto!important;padding:0 13px;border-radius:12px!important;font-size:11px}
.ride{border-left:4px solid var(--gold)}.ridehead{display:flex;justify-content:space-between;gap:8px}.route{font-size:11px;line-height:1.85;margin:11px 0}.price{padding:6px 9px;border-radius:99px;background:#f4ead9;color:#80591d;font-size:10px;font-weight:800;white-space:nowrap}.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.nav{position:fixed;left:50%;bottom:0;transform:translateX(-50%);width:min(560px,100%);height:76px;background:#fffffff5;backdrop-filter:blur(18px);border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);z-index:2000}.nav button{background:transparent;color:#858c94;font-size:8px;font-weight:800;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}.nav button b{width:34px;height:29px;border-radius:11px;display:grid;place-items:center;font-size:17px}.nav button.active{color:var(--night)}.nav button.active b{background:#f1e4cd;color:var(--copper)}
.input,.select,.textarea{width:100%;border:1px solid var(--line);background:#fbfaf8;border-radius:14px;padding:0 12px;outline:0}.input,.select{height:46px}.textarea{padding:12px;min-height:90px;resize:vertical}.label{display:block;font-size:9px;color:var(--muted);font-weight:800;letter-spacing:.6px;text-transform:uppercase;margin:12px 0 5px}
.badge{display:inline-flex;padding:6px 9px;border-radius:99px;font-size:9px;font-weight:800;background:#edf6f1;color:var(--ok)}.badge.warn{background:#fff1dc;color:#95641e}.badge.danger{background:#fbeaea;color:var(--danger)}
.list{display:flex;flex-direction:column;gap:8px}.item{display:flex;align-items:center;gap:11px;padding:12px;border:1px solid var(--line);border-radius:15px;background:#fff}.itemicon{width:38px;height:38px;border-radius:12px;background:#f1ede6;display:grid;place-items:center;flex:none}.item strong{display:block;font-size:11px}.item small{display:block;color:var(--muted);font-size:9px;margin-top:2px}.arrow{margin-left:auto;color:#a0a6ac}
#map{height:260px;border-radius:18px;overflow:hidden;border:1px solid var(--line)}.mapwrap{padding:5px;background:#fff;border:1px solid var(--line);border-radius:21px;box-shadow:var(--shadow)}
.auth{position:fixed;inset:0;z-index:5000;background:radial-gradient(circle at 80% 10%,#d8a84e32,transparent 30%),linear-gradient(145deg,var(--night),var(--blue));display:grid;place-items:center;padding:18px}.authbox{width:100%;max-width:440px;background:#fff;border-radius:29px;padding:24px;box-shadow:0 30px 80px #0006}.authlogo{width:62px;height:62px;border-radius:20px;background:linear-gradient(145deg,var(--gold),var(--copper));color:#fff;display:grid;place-items:center;font:800 28px Outfit;margin-bottom:15px}.auth h2{font:800 28px Outfit;margin:0}.auth p{font-size:11px;color:var(--muted);line-height:1.6}.tabs{display:grid;grid-template-columns:1fr 1fr;gap:5px;background:#f0ece6;padding:4px;border-radius:14px;margin:15px 0}.tabs button{background:transparent;padding:10px;border-radius:11px;font-size:11px;font-weight:800}.tabs button.active{background:#fff}.toast{position:fixed;left:14px;right:14px;bottom:91px;z-index:6000;background:var(--night);color:#fff;padding:13px;border-radius:15px;font-size:11px;opacity:0;transform:translateY(15px);pointer-events:none;transition:.25s}.toast.show{opacity:1;transform:none}
.sheet{position:fixed;inset:0;background:#020913b8;backdrop-filter:blur(6px);z-index:4500;display:none;align-items:flex-end}.sheet.show{display:flex}.sheetbox{width:100%;max-width:560px;margin:auto;background:#fff;border-radius:28px 28px 0 0;padding:22px 18px 30px}.handle{width:38px;height:4px;background:#d7d0c7;border-radius:9px;margin:0 auto 17px}
@media(min-width:700px){.sheet{align-items:center}.sheetbox{border-radius:28px;max-width:470px}}
</style>
</head>
<body>

<div id="auth" class="auth">
  <div class="authbox">
    <div class="authlogo">N</div>
    <h2>NZILA Driver</h2>
    <p>Le cockpit des chauffeurs NZILA. Connectez-vous ou déposez votre candidature pour rejoindre le réseau.</p>
    <div class="tabs">
      <button id="loginTab" class="active" onclick="authMode('login')">Connexion</button>
      <button id="applyTab" onclick="authMode('apply')">Devenir chauffeur</button>
    </div>

    <div id="loginForm">
      <input id="email" class="input" type="email" placeholder="Email">
      <input id="password" class="input" type="password" placeholder="Mot de passe" style="margin-top:8px">
      <button class="primary" style="margin-top:12px" onclick="login()">Entrer dans le cockpit</button>
    </div>

    <div id="applyForm" class="hidden">
      <input id="aEmail" class="input" type="email" placeholder="Email">
      <input id="aPassword" class="input" type="password" placeholder="Mot de passe" style="margin-top:8px">
      <div class="grid">
        <input id="aFirst" class="input" placeholder="Prénom" style="margin-top:8px">
        <input id="aLast" class="input" placeholder="Nom" style="margin-top:8px">
      </div>
      <input id="aPhone" class="input" placeholder="Téléphone" style="margin-top:8px">
      <input id="aLicense" class="input" placeholder="Numéro de permis" style="margin-top:8px">
      <div class="grid">
        <input id="aMake" class="input" placeholder="Marque" style="margin-top:8px">
        <input id="aModel" class="input" placeholder="Modèle" style="margin-top:8px">
        <input id="aPlate" class="input" placeholder="Plaque" style="margin-top:8px">
        <input id="aColor" class="input" placeholder="Couleur" style="margin-top:8px">
      </div>
      <button class="dark" style="margin-top:12px" onclick="applyDriver()">Déposer ma candidature</button>
    </div>
    <div id="authMsg" class="muted" style="margin-top:10px"></div>
  </div>
</div>

<div id="app" class="app hidden">
<header class="top">
  <div class="brand"><div class="logo">N</div><div><b>NZILA DRIVER</b><small>Operating system</small></div></div>
  <button class="iconbtn" onclick="openPage('notifications')">🔔</button>
</header>

<main id="cockpitPage" class="page active">
  <section class="hero">
    <div class="eyebrow">COCKPIT NZILA</div>
    <h1 id="hello">Bonjour 👋</h1>
    <p>Pilotez vos courses, vos revenus et votre activité depuis un seul espace.</p>
  </section>

  <div class="wrap">
    <div id="availabilityCard" class="card">
      <div class="statusbar">
        <div style="display:flex;align-items:center;gap:11px">
          <span class="status-dot"></span>
          <div><div class="status-title" id="onlineTitle">Hors ligne</div><div class="muted" id="onlineText">Vous ne recevez pas de demandes.</div></div>
        </div>
        <button id="onlineSwitch" class="switch" onclick="toggleOnline()"><i></i></button>
      </div>
    </div>

    <div class="grid">
      <div class="metric"><b id="todayRevenue">0</b><span>FCFA aujourd'hui</span></div>
      <div class="metric"><b id="todayCount">0</b><span>Courses terminées</span></div>
      <div class="metric"><b id="rating">5.00</b><span>Note moyenne</span></div>
      <div class="metric"><b id="totalRides">0</b><span>Courses totales</span></div>
    </div>

    <div class="card" style="margin-top:11px">
      <div class="statusbar"><div><b style="font:700 17px Outfit">🎯 Objectif du jour</b><div class="muted" id="goalText">0 / 20 000 FCFA</div></div><b id="goalPercent">0%</b></div>
      <div class="progress"><i id="goalBar" style="width:0%"></i></div>
    </div>

    <div class="sectionhead"><h2>Demandes proches</h2><span id="requestInfo">En attente</span></div>
    <div id="rides"></div>

    <div class="sectionhead"><h2>Course active</h2></div>
    <div id="activeRide"><div class="card"><div class="muted">Aucune course active.</div></div></div>
  </div>
</main>

<main id="ridesPage" class="page">
  <div class="wrap" style="margin-top:15px">
    <div class="sectionhead"><h2>Mes courses</h2></div>
    <div id="myRides" class="list"></div>
  </div>
</main>

<main id="mapPage" class="page">
  <div class="wrap" style="margin-top:15px">
    <div class="sectionhead"><h2>Carte opérationnelle</h2><span id="gpsState">GPS prêt</span></div>
    <div class="mapwrap"><div id="map"></div></div>
    <div class="card" style="margin-top:11px">
      <b style="font:700 17px Outfit">📍 Ma position</b>
      <p class="muted">La position temps réel sera transmise à NZILA lorsque vous êtes en ligne.</p>
      <button class="dark" onclick="locateMe()">Actualiser ma position</button>
    </div>
  </div>
</main>

<main id="walletPage" class="page">
  <div class="wrap" style="margin-top:15px">
    <div class="card" style="background:radial-gradient(circle at 100% 0,#d8a84e42,transparent 35%),linear-gradient(145deg,var(--night),var(--blue));color:#fff">
      <small style="opacity:.7">REVENU DU MOIS</small>
      <div id="monthRevenue" style="font:800 34px Outfit;margin:4px 0 12px">0 FCFA</div>
      <button class="outline" onclick="withdraw()">Demander un retrait</button>
    </div>
    <div class="sectionhead"><h2>Transactions</h2></div>
    <div id="transactions" class="list"></div>
  </div>
</main>

<main id="profilePage" class="page">
  <div class="wrap" style="margin-top:15px">
    <div class="card" style="background:radial-gradient(circle at 100% 0,#d8a84e42,transparent 35%),linear-gradient(145deg,var(--night),var(--blue));color:#fff">
      <div style="display:flex;align-items:center;gap:12px"><div class="logo" style="width:55px;height:55px;font-size:24px" id="avatar">ND</div><div><b id="driverName" style="font:700 20px Outfit">Chauffeur</b><div id="driverStatus" class="muted" style="color:#ffffffaa">Profil NZILA</div></div></div>
    </div>

    <div class="sectionhead"><h2>Mon véhicule</h2></div>
    <div class="card">
      <div class="grid">
        <div><label class="label">Marque</label><input id="vMake" class="input"></div>
        <div><label class="label">Modèle</label><input id="vModel" class="input"></div>
        <div><label class="label">Plaque</label><input id="vPlate" class="input"></div>
        <div><label class="label">Couleur</label><input id="vColor" class="input"></div>
      </div>
      <button class="dark" style="margin-top:10px" onclick="saveVehicle()">Enregistrer</button>
    </div>

    <div class="sectionhead"><h2>Documents</h2></div>
    <div id="documents" class="list"></div>

    <div class="sectionhead"><h2>Mon profil</h2></div>
    <div class="card">
      <label class="label">Prénom</label><input id="pFirst" class="input">
      <label class="label">Nom</label><input id="pLast" class="input">
      <label class="label">Téléphone</label><input id="pPhone" class="input">
      <button class="primary" style="margin-top:12px" onclick="saveProfile()">Enregistrer le profil</button>
    </div>

    <div class="sectionhead"><h2>Centre de sécurité</h2></div>
    <div class="list">
      <button class="item" onclick="incident()"><div class="itemicon">🚨</div><div><strong>Signaler un incident</strong><small>Accident, client, véhicule ou autre</small></div><span class="arrow">›</span></button>
      <button class="item" onclick="toast('Support NZILA : module de messagerie à venir.')"><div class="itemicon">💬</div><div><strong>Support NZILA</strong><small>Assistance chauffeur</small></div><span class="arrow">›</span></button>
      <button class="item" onclick="logout()"><div class="itemicon">↪</div><div><strong>Déconnexion</strong><small>Fermer la session</small></div><span class="arrow">›</span></button>
    </div>
  </div>
</main>

<main id="notificationsPage" class="page">
  <div class="wrap" style="margin-top:15px"><div class="sectionhead"><h2>Notifications</h2></div><div id="notifications" class="list"></div></div>
</main>

<nav class="nav">
  <button class="active" data-page="cockpit" onclick="openPage('cockpit')"><b>◉</b>Cockpit</button>
  <button data-page="rides" onclick="openPage('rides')"><b>🚕</b>Courses</button>
  <button data-page="map" onclick="openPage('map')"><b>⌖</b>Carte</button>
  <button data-page="wallet" onclick="openPage('wallet')"><b>₣</b>Revenus</button>
  <button data-page="profile" onclick="openPage('profile')"><b>●</b>Profil</button>
</nav>
</div>

<div id="rideSheet" class="sheet"><div class="sheetbox"><div class="handle"></div><h2 id="sheetTitle" style="font:700 24px Outfit">Course</h2><p id="sheetText" class="muted"></p><div id="sheetContent"></div><button class="outline" style="margin-top:10px" onclick="closeSheet()">Fermer</button></div></div>
<div id="toast" class="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const SUPABASE_URL='https://dsvbtlwxujuusnarcbfg.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_WYONr6ioYrczatDZGZk4LA_cJMxOJ8G';
const NZILA_SITE_URL='https://gmics51564.github.io/Nzila/driver/';

const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY,{
  auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}
});

let user=null,profile=null,driver=null,online=false,map=null,marker=null,rideChannel=null,gpsWatch=null;

function cfg(){return SUPABASE_URL.startsWith('https://')&&!SUPABASE_PUBLISHABLE_KEY.includes('YOUR_')}
function authMode(mode){
  document.getElementById('loginTab').classList.toggle('active',mode==='login');
  document.getElementById('applyTab').classList.toggle('active',mode==='apply');
  document.getElementById('loginForm').classList.toggle('hidden',mode!=='login');
  document.getElementById('applyForm').classList.toggle('hidden',mode!=='apply');
  document.getElementById('authMsg').textContent='';
}
function authMsg(t){document.getElementById('authMsg').textContent=t}

async function login(){
  if(!cfg())return authMsg('Configuration Supabase incomplète.');
  const email=document.getElementById('email').value.trim(),password=document.getElementById('password').value;
  if(!email||!password)return authMsg('Email et mot de passe requis.');
  const {data,error}=await sb.auth.signInWithPassword({email,password});
  if(error)return authMsg(error.message);
  await boot(data.user);
}

async function applyDriver(){
  if(!cfg())return authMsg('Configuration Supabase incomplète.');
  const email=document.getElementById('aEmail').value.trim(),password=document.getElementById('aPassword').value;
  if(!email||!password)return authMsg('Email et mot de passe requis.');
  const meta={first_name:v('aFirst'),last_name:v('aLast'),phone:v('aPhone')};
  const {data,error}=await sb.auth.signUp({email,password,options:{data:meta,emailRedirectTo:NZILA_SITE_URL}});
  if(error)return authMsg(error.message);
  if(!data.user)return authMsg('Vérifiez votre email pour continuer.');
  const app={
    user_id:data.user.id,license_number:v('aLicense'),
    vehicle_make:v('aMake'),vehicle_model:v('aModel'),
    vehicle_plate:v('aPlate'),vehicle_color:v('aColor')
  };
  const r=await sb.from('driver_applications').insert(app);
  if(r.error)return authMsg(r.error.message);
  authMsg('Candidature déposée. Confirmez votre email puis attendez la validation NZILA.');
}

async function boot(u){
  user=u;
  const p=await sb.from('profiles').select('*').eq('id',u.id).maybeSingle();
  if(p.error)return authMsg(p.error.message);
  if(!p.data){
    const m=u.user_metadata||{};
    const c=await sb.from('profiles').insert({id:u.id,first_name:m.first_name||'',last_name:m.last_name||'',phone:m.phone||'',role:'client'}).select().single();
    if(c.error)return authMsg(c.error.message);
    profile=c.data;
  }else profile=p.data;

  if(profile.role!=='driver')return authMsg('Votre compte n’est pas encore validé comme chauffeur.');

  const d=await sb.from('driver_profiles').select('*').eq('id',u.id).maybeSingle();
  if(d.error)return authMsg(d.error.message);
  if(!d.data)return authMsg('Profil chauffeur introuvable. Contactez NZILA.');
  driver=d.data;
  if(driver.verification_status!=='approved')return authMsg('Votre profil chauffeur est '+driver.verification_status+'.');
  online=!!driver.online;
  document.getElementById('auth').classList.add('hidden');
  document.getElementById('app').classList.remove('hidden');
  renderProfile();renderOnline();initMap();loadDashboard();loadMyRides();loadWallet();loadDocuments();loadNotifications();subscribe();
  if(online)startGPS();
}

sb.auth.onAuthStateChange(async(event,session)=>{
  if(session&&!user)await boot(session.user);
  if(!session){user=null;stopGPS();document.getElementById('auth').classList.remove('hidden');document.getElementById('app').classList.add('hidden');}
});

async function toggleOnline(){
  const next=!online;
  const {data,error}=await sb.rpc('set_driver_online',{p_online:next});
  if(error)return toast(error.message);
  online=!!data.online;driver=data;renderOnline();
  if(online){startGPS();loadDashboard();toast('Vous êtes maintenant en ligne.')}
  else{stopGPS();loadDashboard();toast('Vous êtes hors ligne.')}
}
function renderOnline(){
  const card=document.getElementById('availabilityCard');
  card.classList.toggle('online',online);
  document.getElementById('onlineSwitch').classList.toggle('on',online);
  document.getElementById('onlineTitle').textContent=online?'NZILA ACTIVE':'Hors ligne';
  document.getElementById('onlineText').textContent=online?'Vous pouvez recevoir des demandes.':'Vous ne recevez pas de demandes.';
}
async function loadDashboard(){
  await updateStats();
  const el=document.getElementById('rides');
  if(!online){el.innerHTML='<div class="card" style="text-align:center"><span class="badge warn">HORS LIGNE</span><p class="muted" style="margin-top:8px">Passez en ligne pour recevoir les demandes.</p></div>';return}
  const {data,error}=await sb.from('rides').select('*').in('status',['requested','searching']).order('created_at',{ascending:false}).limit(20);
  if(error){el.innerHTML='<div class="card">'+esc(error.message)+'</div>';return}
  document.getElementById('requestInfo').textContent=(data?.length||0)+' demande(s)';
  el.innerHTML=data?.length?data.map(rideCard).join(''):'<div class="card" style="text-align:center"><p class="muted">Aucune demande pour le moment.</p></div>';
}
function rideCard(r){
  return `<div class="card ride">
    <div class="ridehead"><b>${esc(r.city||r.department)}</b><span class="price">${money(r.estimated_price)} FCFA</span></div>
    <div class="route"><strong>● ${esc(r.pickup_address)}</strong><br>│<br><strong>● ${esc(r.destination_address)}</strong><br>
    <span class="muted">${r.passengers_count} passager(s) · ${r.baggage_count} bagage(s)${r.scheduled_at?' · '+dateTime(r.scheduled_at):''}</span></div>
    <button class="primary" onclick="acceptRide('${r.id}')">Accepter la course</button>
  </div>`;
}
async function acceptRide(id){
  const {data,error}=await sb.rpc('accept_ride',{p_ride_id:id});
  if(error)return toast(error.message);
  toast('Course acceptée.');
  renderActive(data);loadDashboard();loadMyRides();
}
async function loadActive(){
  const {data,error}=await sb.from('rides').select('*').eq('driver_id',user.id).in('status',['accepted','driver_arriving','arrived','in_progress']).order('accepted_at',{ascending:false}).limit(1);
  if(error)return;
  document.getElementById('activeRide').innerHTML=data?.[0]?activeCard(data[0]):'<div class="card"><div class="muted">Aucune course active.</div></div>';
}
function activeCard(r){
  let action='';
  if(r.status==='accepted')action=`<button class="dark" onclick="rideStatus('${r.id}','driver_arriving')">En route</button>`;
  if(r.status==='driver_arriving')action=`<button class="dark" onclick="rideStatus('${r.id}','arrived')">Je suis arrivé</button>`;
  if(r.status==='arrived')action=`<button class="dark" onclick="rideStatus('${r.id}','in_progress')">Démarrer la course</button>`;
  if(r.status==='in_progress')action=`<button class="primary" onclick="rideStatus('${r.id}','completed')">Terminer la course</button>`;
  return `<div class="card ride"><div class="ridehead"><b>Course active</b><span class="badge">${labelStatus(r.status)}</span></div>
  <div class="route"><strong>Départ : ${esc(r.pickup_address)}</strong><br><strong>Destination : ${esc(r.destination_address)}</strong><br><span class="muted">Passager : ${esc(r.passenger_name||'Client')}</span></div>
  <div class="actions">${action}<button class="outline" onclick="openRide('${r.id}')">Détails</button></div></div>`;
}
function renderActive(r){document.getElementById('activeRide').innerHTML=activeCard(r)}
async function rideStatus(id,status){
  const {data,error}=await sb.rpc('driver_update_ride_status',{p_ride_id:id,p_status:status});
  if(error)return toast(error.message);
  renderActive(data);loadDashboard();loadMyRides();
  if(status==='completed'){toast('Course terminée.');updateStats();loadWallet();}
}
async function loadMyRides(){
  const {data,error}=await sb.from('rides').select('*').eq('driver_id',user.id).order('created_at',{ascending:false}).limit(30);
  const el=document.getElementById('myRides');if(!el)return;
  if(error)return el.innerHTML='<div class="card">'+esc(error.message)+'</div>';
  el.innerHTML=data?.length?data.map(r=>`<button class="item" onclick="openRide('${r.id}')"><div class="itemicon">🚕</div><div><strong>${esc(r.pickup_address)} → ${esc(r.destination_address)}</strong><small>${labelStatus(r.status)} · ${money(r.final_price||r.estimated_price)} FCFA · ${dateTime(r.created_at)}</small></div><span class="arrow">›</span></button>`).join(''):'<div class="card"><div class="muted">Aucune course terminée ou passée.</div></div>';
}
async function openRide(id){
  const {data,error}=await sb.from('rides').select('*').eq('id',id).single();
  if(error)return toast(error.message);
  document.getElementById('sheetTitle').textContent='Course NZILA';
  document.getElementById('sheetText').textContent=labelStatus(data.status);
  document.getElementById('sheetContent').innerHTML=`<div class="card" style="box-shadow:none;margin:0;background:#f8f5ef">
    <b>${esc(data.pickup_address)}</b><br><span class="muted">↓</span><br><b>${esc(data.destination_address)}</b>
    <hr style="border:0;border-top:1px solid #e5dfd6;margin:12px 0">
    <div class="muted">Client : ${esc(data.passenger_name||'Client')}<br>Passagers : ${data.passengers_count}<br>Bagages : ${data.baggage_count}<br>Montant : ${money(data.final_price||data.estimated_price)} FCFA</div>
  </div>`;
  document.getElementById('rideSheet').classList.add('show');
}
function closeSheet(){document.getElementById('rideSheet').classList.remove('show')}

async function updateStats(){
  const now=new Date(),start=new Date(now);start.setHours(0,0,0,0);
  const month=new Date(now.getFullYear(),now.getMonth(),1);
  const today=await sb.from('rides').select('final_price,estimated_price,status').eq('driver_id',user.id).eq('status','completed').gte('created_at',start.toISOString());
  const mon=await sb.from('rides').select('final_price,estimated_price').eq('driver_id',user.id).eq('status','completed').gte('created_at',month.toISOString());
  const all=await sb.from('rides').select('id').eq('driver_id',user.id).eq('status','completed');
  const done=today.data||[],m=mon.data||[];
  const rev=done.reduce((a,x)=>a+(x.final_price||x.estimated_price||0),0);
  const monthRev=m.reduce((a,x)=>a+(x.final_price||x.estimated_price||0),0);
  document.getElementById('todayRevenue').textContent=money(rev);
  document.getElementById('todayCount').textContent=done.length;
  document.getElementById('totalRides').textContent=all.data?.length||0;
  document.getElementById('monthRevenue').textContent=money(monthRev)+' FCFA';
  const pct=Math.min(100,Math.round(rev/20000*100));
  document.getElementById('goalText').textContent=money(rev)+' / 20 000 FCFA';
  document.getElementById('goalPercent').textContent=pct+'%';
  document.getElementById('goalBar').style.width=pct+'%';
}
async function loadWallet(){
  const w=await sb.from('wallets').select('id').eq('user_id',user.id).maybeSingle();
  if(!w.data)return;
  const {data}=await sb.from('wallet_transactions').select('*').eq('wallet_id',w.data.id).order('created_at',{ascending:false}).limit(30);
  const el=document.getElementById('transactions');
  el.innerHTML=data?.length?data.map(x=>`<div class="item"><div class="itemicon">${x.type==='credit'?'↑':'↓'}</div><div><strong>${x.type==='credit'?'Crédit':'Débit'} · ${money(x.amount)} FCFA</strong><small>${esc(x.reference||x.status)} · ${dateTime(x.created_at)}</small></div><span class="arrow">${x.status==='completed'?'✓':'…'}</span></div>`).join(''):'<div class="card"><div class="muted">Aucune transaction pour le moment.</div></div>';
}
function withdraw(){const amount=prompt('Montant du retrait en FCFA :');if(!amount||!Number.isFinite(+amount)||+amount<=0)return;toast('Demande de retrait enregistrée dans le prototype. Le paiement Mobile Money sera connecté ensuite.')}
async function loadDocuments(){
  const {data,error}=await sb.from('driver_documents').select('*').eq('driver_id',user.id).order('expires_at');
  const el=document.getElementById('documents');
  if(error)return el.innerHTML='<div class="card">'+esc(error.message)+'</div>';
  el.innerHTML=data?.length?data.map(d=>`<div class="item"><div class="itemicon">📄</div><div><strong>${esc(d.document_type)}</strong><small>${d.expires_at?'Expire le '+dateOnly(d.expires_at):'Date non renseignée'}</small></div><span class="badge ${docClass(d)}">${docLabel(d)}</span></div>`).join(''):'<div class="card"><div class="muted">Aucun document enregistré. L’administration pourra les ajouter.</div></div>';
}
function docClass(d){if(d.status==='rejected')return 'danger';if(d.expires_at&&new Date(d.expires_at)<new Date(Date.now()+30*864e5))return 'warn';return ''}
function docLabel(d){if(d.status==='approved')return 'VALIDÉ';if(d.status==='rejected')return 'REFUSÉ';return 'EN ATTENTE'}
async function loadNotifications(){
  const {data}=await sb.from('notifications').select('*').eq('user_id',user.id).order('created_at',{ascending:false}).limit(30);
  document.getElementById('notifications').innerHTML=data?.length?data.map(n=>`<div class="item"><div class="itemicon">🔔</div><div><strong>${esc(n.title)}</strong><small>${esc(n.body||'')}</small></div></div>`).join(''):'<div class="card"><div class="muted">Aucune notification.</div></div>';
}
function renderProfile(){
  const name=((profile.first_name||'')+' '+(profile.last_name||'')).trim()||'Chauffeur NZILA';
  document.getElementById('hello').textContent='Bonjour '+(profile.first_name||'chauffeur')+' 👋';
  document.getElementById('driverName').textContent=name;
  document.getElementById('driverStatus').textContent='Chauffeur vérifié · '+(driver.rating||5).toFixed(2)+' ★';
  document.getElementById('rating').textContent=(driver.rating||5).toFixed(2);
  document.getElementById('avatar').textContent=((profile.first_name||'N')[0]+(profile.last_name||'Z')[0]).toUpperCase();
  document.getElementById('pFirst').value=profile.first_name||'';document.getElementById('pLast').value=profile.last_name||'';document.getElementById('pPhone').value=profile.phone||'';
  document.getElementById('vMake').value=driver.vehicle_make||'';document.getElementById('vModel').value=driver.vehicle_model||'';document.getElementById('vPlate').value=driver.vehicle_plate||'';document.getElementById('vColor').value=driver.vehicle_color||'';
}
async function saveVehicle(){
  const patch={vehicle_make:v('vMake'),vehicle_model:v('vModel'),vehicle_plate:v('vPlate'),vehicle_color:v('vColor')};
  const {data,error}=await sb.from('driver_profiles').update(patch).eq('id',user.id).select().single();
  if(error)return toast(error.message);driver=data;renderProfile();toast('Véhicule enregistré.');
}
async function saveProfile(){
  const patch={first_name:v('pFirst'),last_name:v('pLast'),phone:v('pPhone')};
  const {data,error}=await sb.from('profiles').update(patch).eq('id',user.id).select().single();
  if(error)return toast(error.message);profile=data;renderProfile();toast('Profil enregistré.');
}
async function incident(){
  const type=prompt('Type d’incident : accident, client, véhicule, route, autre');if(!type)return;
  const description=prompt('Décrivez brièvement la situation :');if(!description)return;
  const {error}=await sb.from('ride_incidents').insert({driver_id:user.id,type,description});
  toast(error?error.message:'Incident transmis à NZILA.');
}
function openPage(p){
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
  document.getElementById(p+'Page').classList.add('active');
  document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.page===p));
  window.scrollTo({top:0,behavior:'smooth'});
  if(p==='cockpit'){loadDashboard();loadActive();}
  if(p==='rides')loadMyRides();
  if(p==='wallet')loadWallet();
  if(p==='profile'){loadDocuments();renderProfile();}
  if(p==='notifications')loadNotifications();
  if(p==='map')setTimeout(()=>map&&map.invalidateSize(),150);
}
function initMap(){
  if(map)return;
  map=L.map('map',{zoomControl:false}).setView([-4.2634,15.2429],11);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(map);
}
function locateMe(){
  if(!navigator.geolocation)return toast('Géolocalisation indisponible.');
  document.getElementById('gpsState').textContent='Recherche…';
  navigator.geolocation.getCurrentPosition(async pos=>{
    const {latitude,longitude,heading,speed}=pos.coords;
    map.setView([latitude,longitude],15);
    if(marker)marker.setLatLng([latitude,longitude]);else marker=L.marker([latitude,longitude]).addTo(map).bindPopup('Votre position NZILA').openPopup();
    document.getElementById('gpsState').textContent='Position actualisée';
    if(online)await sb.from('driver_locations').upsert({driver_id:user.id,latitude,longitude,heading,speed,updated_at:new Date().toISOString()});
  },()=>document.getElementById('gpsState').textContent='Position indisponible',{enableHighAccuracy:true});
}
function startGPS(){
  if(gpsWatch||!navigator.geolocation)return;
  gpsWatch=navigator.geolocation.watchPosition(async pos=>{
    const {latitude,longitude,heading,speed}=pos.coords;
    if(marker)marker.setLatLng([latitude,longitude]);else marker=L.marker([latitude,longitude]).addTo(map);
    await sb.from('driver_locations').upsert({driver_id:user.id,latitude,longitude,heading,speed,updated_at:new Date().toISOString()});
  },()=>{}, {enableHighAccuracy:true,maximumAge:5000,timeout:10000});
}
function stopGPS(){if(gpsWatch!==null){navigator.geolocation.clearWatch(gpsWatch);gpsWatch=null}}
function subscribe(){
  if(rideChannel)sb.removeChannel(rideChannel);
  rideChannel=sb.channel('nzila-driver-'+user.id)
    .on('postgres_changes',{event:'*',schema:'public',table:'rides'},()=>{loadDashboard();loadActive();loadMyRides();updateStats()})
    .on('postgres_changes',{event:'*',schema:'public',table:'notifications',filter:'user_id=eq.'+user.id},loadNotifications)
    .subscribe();
}
async function logout(){stopGPS();await sb.auth.signOut()}
function v(id){return document.getElementById(id).value.trim()}
function money(n){return Number(n||0).toLocaleString('fr-FR')}
function dateTime(s){return new Date(s).toLocaleString('fr-FR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}
function dateOnly(s){return new Date(s).toLocaleDateString('fr-FR')}
function labelStatus(s){return({requested:'Demande',searching:'Recherche',accepted:'Acceptée',driver_arriving:'En route',arrived:'Arrivé',in_progress:'En cours',completed:'Terminée',cancelled:'Annulée'})[s]||s}
function esc(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
let toastTimer;function toast(t){const e=document.getElementById('toast');e.textContent=t;e.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>e.classList.remove('show'),2800)}
window.addEventListener('DOMContentLoaded',async()=>{
  if(!cfg())return authMsg('Configuration Supabase incomplète.');
  const {data,error}=await sb.auth.getSession();
  if(error)return authMsg(error.message);
  if(data.session)await boot(data.session.user);else authMode('login');
});
</script>
</body>
</html>
